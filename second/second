import math

eps = 1e-6
start = [1.0, 1.0]

def f(x1, x2):
    if x1 ** 2 + 2 * x2 ** 2 > 700:
        return 1e300
    return math.sqrt(1 + 2 * x1 ** 2 + x2 ** 2) + math.exp(x1 ** 2 + 2 * x2 ** 2) - x1 - x2


def grad(x1, x2):
    s = math.sqrt(1 + 2 * x1 ** 2 + x2 ** 2)
    e = math.exp(x1 ** 2 + 2 * x2 ** 2)
    g1 = 2 * x1 / s + 2 * x1 * e - 1
    g2 = x2 / s + 4 * x2 * e - 1
    return g1, g2


def nelder_mead(start, eps):
    alpha = 1.0
    beta = 0.5
    gamma = 2.0
    sigma = 0.5
    n = 2
    
    p1 = [start[0], start[1]]
    p2 = [start[0] + 1.0, start[1]]
    p3 = [start[0], start[1] + 1.0]
    points = [p1, p2, p3]
    
    k = 0
    while True:
        values = []
        for p in points:
            values.append(f(p[0], p[1]))
            
        mean = sum(values) / (n + 1)
        s = 0
        for v in values:
            s += (v - mean) ** 2 / (n + 1)
        if math.sqrt(s) < eps:
            break
            
        k += 1
        
        sorted1 = sorted(range(n + 1), key=lambda i: values[i])
        l,g,h = sorted1
        
        xl = points[l]
        xg = points[g]
        xh = points[h]
        
        fl = values[l]
        fg = values[g]
        fh = values[h]
        
        xc = [0.0, 0.0]
        for i in range(n + 1):
            if i != h:
                xc[0] += points[i][0] / n
                xc[1] += points[i][1] / n
                
        fc = f(xc[0], xc[1])
        
        xr = [(1 + alpha) * xc[0] - alpha * xh[0], (1 + alpha) * xc[1] - alpha * xh[1]]
        fr = f(xr[0], xr[1])
        
        if fr < fl:
            xe = [(1 - gamma) * xc[0] + gamma * xr[0], (1 - gamma) * xc[1] + gamma * xr[1]]
            fe = f(xe[0], xe[1])
            if fe < fr:
                points[h] = xe
            else:
                points[h] = xr
        elif fl <= fr < fg:
            points[h] = xr
        elif fg <= fr < fh:
            xk = [xc[0] + beta * (xr[0] - xc[0]), xc[1] + beta * (xr[1] - xc[1])]
            fk = f(xk[0], xk[1])
            if fk <= fr:
                points[h] = xk
            else:
                for i in range(n + 1):
                    if i != l:
                        points[i] = [xl[0] + sigma * (points[i][0] - xl[0]), xl[1] + sigma * (points[i][1] - xl[1])]
        else:
            xk = [xc[0] + beta * (xh[0] - xc[0]), xc[1] + beta * (xh[1] - xc[1])]
            fk = f(xk[0], xk[1])
            if fk < fh:
                points[h] = xk
            else:
                for i in range(n + 1):
                    if i != l:
                        points[i] = [xl[0] + sigma * (points[i][0] - xl[0]), xl[1] + sigma * (points[i][1] - xl[1])]
                        
    values = []
    for p in points:
        values.append(f(p[0], p[1]))
    l = values.index(min(values))
    return points[l], values[l], k



def gradient_method(start, eps):
    x1 = start[0]
    x2 = start[1]
    g1, g2 = grad(x1, x2)
    grad_norm = math.sqrt(g1**2 + g2**2)
    lyambda = 1.0 / grad_norm if grad_norm > 1.0 else 1.0
    k = 0
    while True:

        newx1 = x1 - lyambda * g1
        newx2 = x2 - lyambda * g2
        if f(newx1, newx2) > f(x1, x2):
            lyambda = lyambda / 2
            continue
        k += 1
        diff = abs(f(newx1, newx2) - f(x1, x2))
        x1 = newx1
        x2 = newx2
        if diff < eps:
            break
    return [x1, x2], f(x1, x2), k

p, v, k = nelder_mead(start, eps)
print("Метод Нелдера-Мида")
print("x1 =", p[0], "x2 =", p[1])
print("f min =", v)
print("итераций:", k)

p, v, k = gradient_method(start, eps)
print("Градиентный метод с дроблением шага")
print("x1 =", p[0], "x2 =", p[1])
print("f min =", v)
print("итераций:", k)
